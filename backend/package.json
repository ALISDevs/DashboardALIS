{
  "name": "alis-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:accounts": "node prisma/setupAccounts.js",
    "db:runtime": "node prisma/setupRuntime.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "prisma": "^6.17.1"
  }
}
